# CaptionAI environment
# Copy to .env.local for Next.js and .env for Prisma CLI.

# PostgreSQL (Supabase: Project Settings → Database → URI)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/captionai?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Gemini Vision (required for generation)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# OpenAI Vision fallback
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4.1"

# Supabase Storage (optional in local; filesystem is used when unset)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="captions"

# Email (password reset / verification). Development logs the link if unset.
RESEND_API_KEY=""
EMAIL_FROM="CaptionAI <noreply@localhost>"

# Stripe billing (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# First admin account (seed)
ADMIN_EMAIL="admin@captionai.app"
ADMIN_PASSWORD="ChangeMe_Admin1!"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
